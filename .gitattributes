# Store large binary game assets with Git LFS when pushed through a Git client.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# Keep shipped browser skins and imported playable class models as ordinary web-served files.
skins/lyra-archer-animated.glb -filter -diff -merge -text
skins/classes/*.glb -filter -diff -merge -text
skins/guardiao-solar-animado?*.glb -filter -diff -merge -text
monster_01_pumpkinhead.glb -filter -diff -merge -text
monster_03_ghost.glb -filter -diff -merge -text
monster_10_skeleton.glb -filter -diff -merge -text

# Monster glTF JSON files are small, self-contained, and must be served as real files by Vercel.
assets/monsters/packs/**/*.gltf -filter -diff -merge -text

# Gobkit creature GLBs are small enough to store as ordinary blobs so static hosting serves real files.
assets/monsters/packs/gobkit/**/*.glb -filter -diff -merge -text

# RPG world GLBs must be ordinary Git blobs so Vercel serves the actual model bytes.
assets/world/**/*.glb -filter -diff -merge -text
# Modular village glTF JSON must be ordinary web-served blobs (not Git LFS pointers).
assets/world/village-megakit/**/*.gltf -filter -diff -merge -text

# KayKit weapon glTF descriptors must be real JSON files for Three.js and Vercel.
assets/weapons/kaykit-fantasy-weapons-bits/**/*.gltf -filter -diff -merge -text

# KayKit CC0 Rig_Medium animation clips are served directly to Three.js.
assets/animations/kaykit/**/*.glb -filter -diff -merge -text

# Quaternius CC0 animation GLBs must be stored as real files for browser delivery.
assets/animations/quaternius/**/*.glb -filter -diff -merge -text

# Quaternius CC0 animation GLBs are served as actual web assets.
assets/animations/quaternius/**/*.glb -filter -diff -merge -text

# Quaternius CC0 animation GLBs are served as actual web assets.
assets/animations/quaternius/**/*.glb -filter -diff -merge -text

# Kenney CC0 particle textures are served as actual PNG files.
assets/effects/**/*.png -filter -diff -merge -text
